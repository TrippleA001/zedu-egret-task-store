# Supabase (publishable key is safe client-side; secret key is SERVER ONLY)
NEXT_PUBLIC_SUPABASE_URL=https://wntkuzptzdtcewrxljcb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable-placeholder
# New projects: sb_secret_... Legacy projects: eyJ... service_role JWT. Either works.
SUPABASE_SECRET_KEY=sb_secret_placeholder-never-expose-to-client
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://wntkuzptzdtcewrxljcb.supabase.co/auth/v1/.well-known/jwks.json

# GitHub PAT for server-side repo checks (api.github.com). Scopes: public_repo read is enough for public repos.
GITHUB_PAT=ghp_placeholder

# Mailgun
MAILGUN_API_KEY=mailgun-placeholder
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=no-reply@example.com

# Webhook secret to trigger contributors rebuild (GitHub repository_dispatch)
CONTRIBUTORS_WEBHOOK_URL=
CONTRIBUTORS_WEBHOOK_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
